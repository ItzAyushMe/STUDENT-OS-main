# ============================================================
# StudentOS — environment variables
# Copy this file to `.env` and fill in your keys.
# NOTE: Expo only exposes variables prefixed with EXPO_PUBLIC_
# to the app bundle. Keep the EXPO_PUBLIC_ prefix.
# ============================================================

# ---------- Supabase (optional) ----------
# Create a free project at https://supabase.com, then copy the
# Project URL and anon public key from Settings -> API.
# If left empty, StudentOS runs in LOCAL MODE (offline, device-only
# storage) — perfect for trying the app without any setup.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Set to 1 for the PURE ONLINE release build: guest login is hidden,
# demo rivals never appear, and without Supabase configured the app
# shows a clear "backend not configured" setup screen.
EXPO_PUBLIC_CLOUD_ONLY=0

# ---------- AI providers (at least one recommended) ----------
# Google Gemini key: https://aistudio.google.com/apikey
EXPO_PUBLIC_GEMINI_API_KEY=
# Groq key: https://console.groq.com/keys
EXPO_PUBLIC_GROQ_API_KEY=

# Default AI provider: "groq" (default, fastest) or "gemini".
# You can also switch this at runtime from the app's Settings screen.
EXPO_PUBLIC_AI_PROVIDER=groq
